{
  "schemaVersion": 1,
  "id": "ae2",
  "version": "${version}",
  "name": "Applied Energistics 2",
  "description": "A Minecraft mod about Matter, Energy and using them to conquer the world...",
  "authors": ["AlgorithmX2", "Applied Energistics Team"],
  "contact": {
    "homepage": "https://appliedenergistics.org",
    "sources": "https://github.com/AppliedEnergistics/Applied-Energistics-2",
    "issues": "https://github.com/AppliedEnergistics/Applied-Energistics-2/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/ae2/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["appeng.fabric.AppEngFabric"],
    "client": ["appeng.fabric.client.AppEngFabricClient"],
    "ae2:client_registration": [
      {
        "adapter": "default",
        "value": "appeng.fabric.client.AE2ClientSelfRegistration"
      }
    ],
    "rei_common": ["appeng.integration.modules.rei.ReiPlugin"],
    "rei_client": ["appeng.client.integration.rei.ReiClientPlugin"],
    "jei_mod_plugin": ["appeng.client.integrations.jei.JEIPlugin"],
    "jade": ["appeng.integration.modules.jade.JadeModule"]
  },
  "mixins": ["ae2.mixins.json", "ae2-fabric.mixins.json"],
  "accessWidener": "ae2.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "team_reborn_energy": "*",
    "guideme": "*"
  }
}
